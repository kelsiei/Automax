@model Automax.Models.Settings.UserPreferencesViewModel

@{
    ViewData["Title"] = "My Settings";
}

<h1>My Settings</h1>

@if (TempData["StatusMessage"] is string status && !string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-success" role="alert">
        @status
    </div>
}

<form asp-action="Index" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="PreferredUnits" class="form-label"></label>
        <select asp-for="PreferredUnits" class="form-select">
            <option value="">(Use default)</option>
            <option value="Metric">Metric (km, L/100)</option>
            <option value="Imperial">Imperial (mi, MPG)</option>
        </select>
        <span asp-validation-for="PreferredUnits" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DefaultLandingPage" class="form-label"></label>
        <select asp-for="DefaultLandingPage" class="form-select">
            <option value="Dashboard">Dashboard</option>
            <option value="Garage">Garage</option>
        </select>
        <span asp-validation-for="DefaultLandingPage" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="ShowFuelWidget" class="form-check-input" />
        <label asp-for="ShowFuelWidget" class="form-check-label"></label>
        <span asp-validation-for="ShowFuelWidget" class="text-danger"></span>
        <div class="form-text">Uncheck to hide the fuel summary card on the dashboard.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary ms-2">Back to Dashboard</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
