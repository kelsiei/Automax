@model Automax.Models.Home.HomeDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<p class="text-muted">Overview of your garage, urgent reminders, and quick access to upcoming items.</p>

@if (Model.IsAuthenticated)
{
    <p class="text-muted">
        Signed in as
        <strong>
            @(string.IsNullOrWhiteSpace(Model.UserName) ? "current user" : Model.UserName)
        </strong>
        @if (Model.IsRootUser)
        {
            <span class="badge bg-danger ms-2">Root</span>
        }
        else if (Model.IsAdmin)
        {
            <span class="badge bg-primary ms-2">Admin</span>
        }
        else
        {
            <span class="badge bg-secondary ms-2">User</span>
        }
    </p>
}
else
{
    <p class="text-muted">
        You are not currently signed in. Only public information (such as the Message of the Day) is shown here.
    </p>
}

@if (Model.ShowMotd)
{
    <div class="alert alert-info" role="alert">
        <strong>Message of the Day:</strong>
        <div>@Model.Motd</div>
    </div>
}

<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card dashboard-metric-card shadow-sm">
            <div class="card-body">
                <h6 class="card-title text-muted">Vehicles</h6>
                <p class="display-6 mb-0">@Model.VehicleCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-metric-card shadow-sm">
            <div class="card-body">
                <h6 class="card-title text-muted">Urgent Vehicles</h6>
                <p class="display-6 mb-0">@Model.VehiclesWithUrgentReminders</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-metric-card shadow-sm">
            <div class="card-body">
                <h6 class="card-title text-muted">Open Reminders</h6>
                <p class="display-6 mb-0">@Model.OpenRemindersCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card dashboard-metric-card shadow-sm">
            <div class="card-body">
                <h6 class="card-title text-muted">Upcoming (30d)</h6>
                <p class="display-6 mb-0">@Model.UpcomingReminders.Count</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Upcoming Reminders (30 days)</span>
                <a asp-controller="Reminder" asp-action="Index" class="btn btn-sm btn-outline-primary">Reminders</a>
            </div>
            <div class="card-body">
                @if (Model.UpcomingReminders != null && Model.UpcomingReminders.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var r in Model.UpcomingReminders.Take(8))
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>@(r.DueDate?.ToShortDateString() ?? "")</strong>
                                    <span class="badge @(r.IsCompleted ? "bg-success" : "bg-secondary")">
                                        @(r.IsCompleted ? "Completed" : "Open")
                                    </span>
                                </div>
                                <div class="small text-muted">@r.Year @r.Make @r.Model (@r.LicensePlate)</div>
                                <div>@r.Description</div>
                                <div class="small">Urgency: @r.Urgency @if (!string.IsNullOrWhiteSpace(r.Tags)) { <span class="text-muted">| @r.Tags</span> }</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No upcoming date-based reminders in the next 30 days.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Services</span>
                <a asp-controller="Service" asp-action="Index" class="btn btn-sm btn-outline-primary">Services</a>
            </div>
            <div class="card-body">
                @if (Model.RecentServices != null && Model.RecentServices.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var s in Model.RecentServices.Take(8))
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@s.Date.ToShortDateString()</strong>
                                    <div class="small text-muted">Vehicle #@s.VehicleId</div>
                                    <div>@s.Description</div>
                                </div>
                                @if (s.Cost.HasValue)
                                {
                                    <span class="badge bg-light text-dark">Cost: @s.Cost.Value.ToString("C")</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No service records yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.ShowFuelWidget)
{
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Fuel Summary @if (!string.IsNullOrWhiteSpace(Model.PreferredUnits)) { <span class="text-muted">(@Model.PreferredUnits)</span> }</span>
                    <a asp-controller="Gas" asp-action="Index" class="btn btn-sm btn-outline-primary">Fuel Logs</a>
                </div>
                <div class="card-body">
                    @if (Model.FuelSummaries != null && Model.FuelSummaries.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var f in Model.FuelSummaries.Take(8))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="small text-muted">Vehicle #@f.VehicleId</div>
                                        <div>Avg Efficiency: @f.AverageEfficiency.ToString("0.##")</div>
                                    </div>
                                    <span class="badge bg-light text-dark">Fuel Cost: @f.TotalFuelCost.ToString("C")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No fuel records available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

<p class="mt-3">
    <a asp-controller="Vehicle" asp-action="Index" class="btn btn-primary">Go to Garage</a>
    <a asp-controller="Report" asp-action="Index" class="btn btn-secondary ms-2">View Reports</a>
</p>
